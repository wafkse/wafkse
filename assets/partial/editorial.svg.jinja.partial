<svg xmlns="http://www.w3.org/2000/svg" width="960" height="260" viewBox="0 0 960 260" role="img" aria-labelledby="title description">
  <title id="title">{{ profile.primary }} {{ profile.secondary }}</title>
  <desc id="description">{{ profile.description }}</desc>
  <defs>
    <radialGradient id="accent" cx="82%" cy="47%" r="72%">
      <stop stop-color="{{ color.accent }}" stop-opacity=".14"/>
      <stop offset="1" stop-color="{{ color.accent }}" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect x=".5" y=".5" width="959" height="259" rx="4" fill="{{ color.panel }}" stroke="{{ color.surface }}" stroke-opacity=".65"/>
  <rect x="4" y="4" width="4" height="252" rx="1" fill="{{ color.accent }}"/>
  <rect x="8" y="2" width="949" height="256" fill="url(#accent)"/>
  <text x="42" y="95" fill="{{ color.text }}" font-family="monospace" font-size="61" font-weight="400" letter-spacing="-.8">{{ profile.primary }}</text>
  <text x="42" y="166" fill="{{ color.accent }}" font-family="monospace" font-size="60" font-weight="400" letter-spacing="-1.8">{{ profile.secondary }}</text>
  <text x="44" y="220" fill="{{ color.subtext }}" font-family="Georgia,serif" font-size="22">{{ profile.description }}</text>
  <path d="M42 237H918" stroke="{{ color.surface }}" stroke-opacity=".5"/>
</svg>
