<svg xmlns="http://www.w3.org/2000/svg" width="1040" height="170" viewBox="0 0 1040 170" role="img" aria-labelledby="signal-title signal-desc">
  <title id="signal-title">Contribution signal</title>
  <desc id="signal-desc">A small rendering of the past 52 weeks of GitHub contributions. {{ signal.range_label }}</desc>
  <rect x="1" y="1" width="1038" height="168" rx="10" fill="{{ color.base }}" stroke="{{ color.border }}" stroke-width="2"/>
  <path d="M278 20v130" stroke="{{ color.border }}" opacity=".65"/>
  <text x="27" y="35" fill="{{ color.secondary }}" font-family="ui-monospace, monospace" font-size="12" letter-spacing="2">ACTIVITY / GITHUB</text>
  <text x="25" y="97" fill="{{ color.ink }}" font-family="ui-monospace, monospace" font-size="50" font-weight="700">{{ signal.total_label }}</text>
  <text x="28" y="121" fill="{{ color.muted }}" font-family="ui-monospace, monospace" font-size="12">contributions · 52 weeks</text>
  <text x="28" y="150" fill="{{ color.muted }}" font-family="ui-monospace, monospace" font-size="10" letter-spacing="1">{{ signal.range_label }}</text>
  <g stroke="{{ color.grid }}" fill="none" stroke-width="1">
    <path d="M316 42H1007M316 77H1007M316 112H1007M316 147H1007"/>
    <path d="M316 25V147M405 25V147M494 25V147M583 25V147M672 25V147M761 25V147M850 25V147M939 25V147M1007 25V147"/>
  </g>
  <path d="{{ signal.area }}" fill="{{ color.accent }}" opacity=".14"/>
  <polyline points="{{ signal.points }}" fill="none" stroke="{{ color.accent }}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
  <path d="M316 147H1007" stroke="{{ color.secondary }}" opacity=".6"/>
  <text x="1003" y="23" fill="{{ color.muted }}" font-family="ui-monospace, monospace" font-size="10" text-anchor="end" letter-spacing="1">ROLLING WINDOW</text>
</svg>
