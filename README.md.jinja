<p align="center">
  <a href="https://{{ profile.website }}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="./assets/website-mocha.svg">
      <img src="./assets/website-latte.svg" width="340" alt="{{ profile.website }}">
    </picture>
  </a>
</p>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/rhythm-mocha.svg">
  <img src="./assets/rhythm-latte.svg" width="100%" alt="Commit activity by weekday and hour, UTC, over the past 90 days">
</picture>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/source-mocha.svg">
  <img src="./assets/source-latte.svg" width="100%" alt="GitHub Linguist language byte proportions across public repositories">
</picture>

<p align="center">
  <img src="https://count.getloli.com/@{{ profile.username }}.github?name={{ profile.username }}.github&amp;theme={{ profile.counter_theme }}&amp;padding=7&amp;offset=0&amp;align=center&amp;scale={{ profile.counter_scale }}&amp;pixelated=1&amp;darkmode=auto" width="{{ profile.counter_width }}" alt="Profile visit counter">
</p>
