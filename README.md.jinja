<p align="center">
  <a href="https://{{ profile.website }}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="./assets/website-mocha.svg">
      <img src="./assets/website-latte.svg" width="100%" alt="My Website: {{ profile.website }}">
    </picture>
  </a>
</p>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/rhythm-mocha.svg">
  <img src="./assets/rhythm-latte.svg" width="100%" alt="Commit activity by weekday and hour, UTC, over the past 90 days">
</picture>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/language-mocha.svg">
  <img src="./assets/language-latte.svg" width="100%" alt="Known languages: Rust, C, C++, Lua / Luau, TypeScript, Python">
</picture>

